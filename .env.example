# JalSentry Environment Configuration Template
# Copy to .env.local for local overrides. Safe placeholders only.

# Environment Mode
NODE_ENV=development

# AWS Configuration (When connecting to live AWS infrastructure)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=JalSentry

# Optional: Set this to your deployed Amazon API Gateway HTTP API base URL
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_API_URL=

# Storage Mode:
# Leave blank to automatically use AWS DynamoDB if AWS credentials/Lambda environment are present.
# Set to 'memory' to explicitly force the in-memory fallback store during local development or offline mode.
JALSENTRY_STORAGE=
